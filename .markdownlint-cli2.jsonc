{
  "overrides": [
    {
      "filter": [
        "README.md"
      ],
      "config": {
        "MD033": {
          "allowed_elements": [
            "p",
            "img",
            "details",
            "summary"
          ]
        },
        "MD041": {
          "allow_preamble": true,
          "level": 2
        }
      },
      "combine": "merge"
    },
    {
      "filter": [
        "prototype_snapshot.md"
      ],
      "config": {
        "MD033": {
          "allowed_elements": [
            "p",
            "img",
            "table",
            "tr",
            "td",
            "strong",
            "big",
            "br",
            "h3"
          ]
        }
      },
      "combine": "merge"
    }
  ]
}
